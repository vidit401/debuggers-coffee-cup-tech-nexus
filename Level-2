# Scenario: A coffee shop wants to remove all orders that are just "Water" from their pending list.

orders = ["Latte", "Water", "Water", "Espresso", "Water", "Cappuccino"]

def cleanup_orders(order_list):
    for item in order_list:
        if item == "Water":
            order_list.remove(item)
    return order_list

clean_list = cleanup_orders(orders)
print("Final Orders: ", clean_list)
